# VanguardCOD Frontend Environment Configuration
# Copy this to frontend/.env to override the backend proxy target

# If your backend is exposed via ngrok (for WhatsApp / Twilio webhooks):
# VITE_BACKEND_URL=https://your-subdomain.ngrok-free.dev

# Local backend default:
VITE_BACKEND_URL=http://127.0.0.1:8100
