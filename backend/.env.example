# VanguardCOD backend environment
# Copy this file to backend/.env and fill in the values.
# .env is gitignored. Real OS environment variables win over this file.

APP_NAME=VanguardCOD
APP_VERSION=0.1.0
API_PREFIX=/api/v1
ENVIRONMENT=development

# Groq powers all AI in the project: Llama chat, Whisper STT, and Orpheus TTS.
# Create a key at https://console.groq.com/keys
# Leave empty to run the deterministic mock planner instead of real inference.
GROQ_API_KEY=

# SQLite is the zero-setup default. For PostgreSQL use:
# postgresql+asyncpg://user:password@host:5432/vanguard_cod
DATABASE_URL=sqlite+aiosqlite:///./vanguard_cod.db

# This is YOUR app tenant key, not a third-party API key.
# Generate one with:
# python -c "import secrets; print('vcod_' + secrets.token_urlsafe(24))"
# Send it as the X-Tenant-API-Key header.
DEFAULT_TENANT_API_KEY=vcod_live_demo_key_2026

STT_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en
LLM_MODEL=llama-3.3-70b-versatile
FAST_LLM_MODEL=llama-3.1-8b-instant
TTS_MODEL=canopylabs/orpheus-v1-english
# Orpheus voices: troy, hannah, austin, daniel, autumn, diana
TTS_DEFAULT_VOICE=troy
LLM_TEMPERATURE=0.1
# Seconds an unexpectedly disconnected ACTIVE call stays resumable before it is completed.
CALL_RECONNECT_GRACE_SECONDS=60

SEED_ON_STARTUP=false
ALLOW_ANONYMOUS_TENANT=true
CORS_ORIGINS=*

# Optional integrations for later phases. Current Phase 1 and 2 code does not read these yet.
# Twilio for real PSTN phone calls: https://console.twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# Azure Speech for Urdu neural TTS: https://portal.azure.com (Speech resource)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
